# Copy this file to .env on the VPS and fill in real values.
# Never commit the real .env file.

POSTGRES_DB=agricul
POSTGRES_USER=agricul
POSTGRES_PASSWORD=change-me-to-a-long-random-value

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/agricul
SPRING_DATASOURCE_USERNAME=agricul
SPRING_DATASOURCE_PASSWORD=change-me-to-a-long-random-value
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# First administrator: this account becomes ADMIN when it signs in with a verified e-mail.
# Remove once admins manage roles from the app.
BOOTSTRAP_ADMIN_EMAIL=

# Origins allowed to call the API (comma-separated, no spaces, no trailing slash)
CORS_ALLOWED_ORIGINS=https://app.agrishare.farm

# Baked into the frontend at build time (Next.js NEXT_PUBLIC_* vars are build-time only)
NEXT_PUBLIC_API_URL=https://api.agrishare.farm

# Public URL of the frontend, used in the links sent by e-mail
APP_FRONTEND_URL=https://app.agrishare.farm

# Outgoing e-mail (account verification, password reset) through the Mailcow server
MAIL_ENABLED=true
MAIL_HOST=mail.agrishare.farm
MAIL_PORT=587
MAIL_USERNAME=no-reply@agrishare.farm
MAIL_PASSWORD=change-me
MAIL_FROM=AgriShare <no-reply@agrishare.farm>

# Sessions (optional, these are the defaults): sign-out after 30 min idle, and 12 h after
# login whatever the activity. Cookies are Secure with the __Host- prefix.
# SESSION_IDLE_TIMEOUT=30m
# SESSION_ABSOLUTE_TIMEOUT=12h
# COOKIE_SECURE=true

# "Sign in with Google": OAuth client of type "Web application" in Google Cloud, with the
# redirect URI https://api.agrishare.farm/login/oauth2/code/google. Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
